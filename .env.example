# ---- SMTP 发信配置（邮件通知用） ----
# 复制本文件为 .env 并填写真实值；.env 不会被提交到 git。
# 在 Vercel 上请到 Settings → Environment Variables 设置同名变量。

# SMTP 主机，例如：
#   Gmail:        smtp.gmail.com
#   腾讯企业邮:    smtp.exmail.qq.com
#   Outlook/微软: smtp.office365.com
SMTP_HOST=smtp.example.com

# 端口：587（STARTTLS）或 465（SSL）
SMTP_PORT=587

# 465 端口时填 true，587 填 false
SMTP_SECURE=false

# 发信账号（邮箱地址）
SMTP_USER=your-email@example.com

# 发信密码 / 授权码（Gmail 等需用「应用专用密码」，不是登录密码）
SMTP_PASS=your-app-password

# 收通知的邮箱；留空则自动发到该预约对应门店的 email
NOTIFY_EMAIL=

# 发件人显示名（可选）
FROM_NAME=iShine Wellness
